# GlucoTwin .gitignore

# Data (never commit raw patient data)
data/raw/
data/processed/
data/interim/
*.csv
*.parquet
*.h5
*.hdf5
*.pkl
# Model artifacts (keep production models, ignore scratch/large binaries)
/models/*
!/models/glucotwin_production_model.joblib
!/models/glucotwin_calibrator.joblib
!/models/glucotwin_calibrator_metadata.json
!/models/.gitkeep
!/models/*.joblib
*.model
*.pth
*.pt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.env
.venv
env/
venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
.claude/
.gemini/
.jolli/

# Secrets / credentials
*.key
*.pem
*.env
secrets.yaml
.kaggle/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temp outputs — keep reports/docs
outputs/tmp/
.pytest_tmp/
.pytest_cache/
.agent-collab/
